# =============================================================================
# CrashCourse - code-only repository
#
# Versioned:   Source/, Config/, *.uproject, .gitattributes, .gitignore, docs
# NOT versioned: all assets, imported marketplace content, build output,
#                generated solution/IDE files, caches, local saves.
#
# A fresh clone opens with an empty Content/ folder; the editor recreates it.
# To rebuild the project locally, re-import the marketplace packs listed in
# the README (ParagonBoris, ParagonMinions, ...).
# =============================================================================

# -----------------------------------------------------------------------------
# Unreal Engine - build output / generated directories
# -----------------------------------------------------------------------------
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
/Plugins/**/Saved/
/Plugins/**/DerivedDataCache/

# Build/ is mostly generated, but the few hand-written files must survive
/Build/*
!/Build/*/
!/Build/**/*.ico
!/Build/**/PakBlacklist*.txt

# Generated project/solution files
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.VC.VC.opendb
*.xcodeproj
*.xcworkspace
/.vsconfig.user

# -----------------------------------------------------------------------------
# Assets - everything under Content/ (maps, meshes, textures, blueprints,
# marketplace packs). Keep only source code in this repo.
# -----------------------------------------------------------------------------
/Content/
/Plugins/**/Content/

# Asset file types, ignored anywhere else they might appear
*.uasset
*.umap
*.ubulk
*.uexp
*.ucas
*.utoc
*.ushaderbytecode
*.upipelinecache
*.pak
*.sig

# Imported source art that gets cooked into the assets above
/SourceArt/
*.fbx
*.obj
*.abc
*.gltf
*.glb
*.blend
*.max
*.ma
*.mb
*.c4d
*.spp
*.sbs
*.sbsar
*.ztl
*.zpr
*.vox
*.stl
*.ply
*.dae
*.3ds

# Textures / audio / video (never needed for a code-only repo)
*.tga
*.psd
*.tif
*.tiff
*.exr
*.hdr
*.dds
*.wav
*.aiff
*.flac
*.mp3
*.ogg
*.mp4
*.mov
*.bik

# -----------------------------------------------------------------------------
# IDE / editor user state
# -----------------------------------------------------------------------------
/.vs/
/.idea/
/.vscode/
*.user
*.userprefs
*.DotSettings.user
*.code-workspace
.ignore

# -----------------------------------------------------------------------------
# Local / machine-specific config
# -----------------------------------------------------------------------------
Config/*Local*.ini
Config/*User*.ini
Config/*.log

# -----------------------------------------------------------------------------
# Logs, crash dumps, misc artifacts
# -----------------------------------------------------------------------------
*.log
*.dmp
*.crashreport
crashinfo.xml
CrashReportClient.exe
/Saved/Crashes/
Logs/
Automation/*
VisualStudioTiming.log
UnrealVersionSelector.log

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
