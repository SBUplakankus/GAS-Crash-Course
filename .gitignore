# =============================================================================
# CrashCourse
#
# Versioned:     Source/, Config/, Content/ (own maps + blueprints),
#                *.uproject, .gitattributes, .gitignore
# NOT versioned: imported marketplace packs (~6 GB of meshes/textures),
#                raw 3D source files, build output, generated solutions,
#                IDE state, caches, local saves.
# =============================================================================

# -----------------------------------------------------------------------------
# Unreal Engine - build output / generated directories
# -----------------------------------------------------------------------------
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
/Plugins/**/Saved/
/Plugins/**/DerivedDataCache/

# Build/ is mostly generated, but the few hand-written files must survive
/Build/*
!/Build/*/
!/Build/**/*.ico
!/Build/**/PakBlacklist*.txt

# Generated project/solution files
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.VC.VC.opendb
*.xcodeproj
*.xcworkspace
/.vsconfig.user

# -----------------------------------------------------------------------------
# Content - tracked, EXCEPT imported asset packs
#
# Content/_CrashCourse (own maps, blueprints) IS committed.
# The imported marketplace packs below are not: ParagonBoris ~1.3 GB,
# ParagonMinions ~4.9 GB. Re-import them locally to run the project.
# -----------------------------------------------------------------------------
/Content/ParagonBoris/
/Content/ParagonMinions/

# New imported pack? Add one line per top-level pack folder:
# /Content/<PackName>/

# Generated / cooked asset sidecars and packaged output
*.ubulk
*.uexp
*.ucas
*.utoc
*.ushaderbytecode
*.upipelinecache
*.pak
*.sig

# Raw 3D / DCC source art - the heavy stuff, never in source control
/SourceArt/
*.fbx
*.obj
*.abc
*.gltf
*.glb
*.blend
*.max
*.ma
*.mb
*.c4d
*.spp
*.sbs
*.sbsar
*.ztl
*.zpr
*.vox
*.stl
*.ply
*.dae
*.3ds

# Raw texture / audio / video files (the cooked .uasset versions are what ships)
*.tga
*.psd
*.tif
*.tiff
*.exr
*.hdr
*.dds
*.wav
*.aiff
*.flac
*.mp3
*.ogg
*.mp4
*.mov
*.bik

# -----------------------------------------------------------------------------
# IDE / editor user state
# -----------------------------------------------------------------------------
/.vs/
/.idea/
/.vscode/
*.user
*.userprefs
*.DotSettings.user
*.code-workspace
.ignore

# -----------------------------------------------------------------------------
# Local / machine-specific config
# -----------------------------------------------------------------------------
Config/*Local*.ini
Config/*User*.ini
Config/*.log

# -----------------------------------------------------------------------------
# Logs, crash dumps, misc artifacts
# -----------------------------------------------------------------------------
*.log
*.dmp
*.crashreport
crashinfo.xml
CrashReportClient.exe
/Saved/Crashes/
Logs/
Automation/*
VisualStudioTiming.log
UnrealVersionSelector.log

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
